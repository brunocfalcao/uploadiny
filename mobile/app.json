{
  "expo": {
    "name": "Uploadiny",
    "slug": "uploadiny",
    "version": "0.14.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "uploadiny",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "32",
      "bundleIdentifier": "test.uploadiny.app"
    },
    "plugins": [
      "./plugins/with-scene-lifecycle",
      "./plugins/with-uploadiny-share-extension",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "extensionBundleIdentifier": "test.uploadiny.app.share",
            "activationRule": {
              "supportsImageWithMaxCount": 1000,
              "supportsMovieWithMaxCount": 1000
            }
          }
        }
      ]
    ]
  }
}
